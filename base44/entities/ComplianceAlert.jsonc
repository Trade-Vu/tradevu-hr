{
  "name": "ComplianceAlert",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "Organization ID"
    },
    "alert_type": {
      "type": "string",
      "enum": [
        "visa_expiry",
        "iqama_expiry",
        "gosi_discrepancy",
        "overdue_task",
        "probation_review",
        "contract_renewal",
        "document_expiry",
        "attendance_issue"
      ],
      "description": "Type of compliance alert"
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium",
      "description": "Alert severity level"
    },
    "employee_id": {
      "type": "string",
      "description": "Related employee ID"
    },
    "employee_name": {
      "type": "string",
      "description": "Employee name for reference"
    },
    "alert_message": {
      "type": "string",
      "description": "Human-readable alert message"
    },
    "alert_details": {
      "type": "object",
      "description": "Detailed information about the alert"
    },
    "expiry_date": {
      "type": "string",
      "format": "date",
      "description": "Relevant expiry or due date"
    },
    "days_until_expiry": {
      "type": "number",
      "description": "Days remaining until expiry"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "acknowledged",
        "resolved",
        "dismissed"
      ],
      "default": "active",
      "description": "Alert status"
    },
    "acknowledged_by": {
      "type": "string",
      "description": "Who acknowledged the alert"
    },
    "acknowledged_date": {
      "type": "string",
      "format": "date-time",
      "description": "When alert was acknowledged"
    },
    "resolved_date": {
      "type": "string",
      "format": "date-time",
      "description": "When issue was resolved"
    },
    "resolution_notes": {
      "type": "string",
      "description": "Notes about resolution"
    },
    "ai_generated": {
      "type": "boolean",
      "default": true,
      "description": "Whether alert was generated by AI"
    },
    "auto_escalate": {
      "type": "boolean",
      "default": false,
      "description": "Whether to auto-escalate if not resolved"
    }
  },
  "required": [
    "organization_id",
    "alert_type",
    "alert_message"
  ]
}