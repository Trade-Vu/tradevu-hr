{
  "name": "PayrollSuggestion",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "Organization ID"
    },
    "employee_id": {
      "type": "string",
      "description": "Employee ID"
    },
    "employee_name": {
      "type": "string",
      "description": "Employee name"
    },
    "month": {
      "type": "string",
      "description": "Payroll month (YYYY-MM)"
    },
    "suggestion_type": {
      "type": "string",
      "enum": [
        "overtime_adjustment",
        "leave_deduction",
        "allowance_change",
        "error_detection",
        "gosi_adjustment"
      ],
      "description": "Type of suggestion"
    },
    "current_value": {
      "type": "number",
      "description": "Current calculated value"
    },
    "suggested_value": {
      "type": "number",
      "description": "AI suggested value"
    },
    "difference": {
      "type": "number",
      "description": "Difference between values"
    },
    "reason": {
      "type": "string",
      "description": "AI explanation for suggestion"
    },
    "confidence_score": {
      "type": "number",
      "description": "AI confidence level (0-100)"
    },
    "supporting_data": {
      "type": "object",
      "description": "Data supporting the suggestion"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "rejected",
        "implemented"
      ],
      "default": "pending",
      "description": "Suggestion status"
    },
    "reviewed_by": {
      "type": "string",
      "description": "Who reviewed the suggestion"
    },
    "reviewed_date": {
      "type": "string",
      "format": "date-time",
      "description": "When reviewed"
    },
    "ai_generated": {
      "type": "boolean",
      "default": true,
      "description": "Generated by AI"
    }
  },
  "required": [
    "organization_id",
    "employee_id",
    "month",
    "suggestion_type",
    "suggested_value",
    "reason"
  ]
}